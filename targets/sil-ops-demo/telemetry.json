{
  "layouts": [
    {
      "name": "Default",
      "plots": [
        {
          "title": "WaveGenerator#0 Output",
          "channels": [
            "WaveGenerator#0.waveType",
            "WaveGenerator#0.frequency",
            "WaveGenerator#0.amplitude",
            "WaveGenerator#0.output",
            "WaveGenerator#0.peakPos",
            "WaveGenerator#0.peakNeg",
            "WaveGenerator#0.rms",
            "WaveGenerator#0.sampleCount"
          ],
          "height": 200
        },
        {
          "title": "WaveGenerator#0 Output",
          "channels": ["WaveGenerator#0.output", "WaveGenerator#0.phase"],
          "height": 200
        },
        {
          "title": "WaveGenerator#1 Output",
          "channels": [
            "WaveGenerator#1.waveType",
            "WaveGenerator#1.frequency",
            "WaveGenerator#1.amplitude",
            "WaveGenerator#1.output",
            "WaveGenerator#1.peakPos",
            "WaveGenerator#1.peakNeg",
            "WaveGenerator#1.rms",
            "WaveGenerator#1.sampleCount"
          ],
          "height": 200
        },
        {
          "title": "WaveGenerator#1 Output",
          "channels": ["WaveGenerator#1.output", "WaveGenerator#1.phase"],
          "height": 200
        },
        {
          "title": "TelemetryManager Output",
          "channels": [
            "TelemetryManager.collectCount",
            "TelemetryManager.packetsSent",
            "TelemetryManager.sendFailures",
            "TelemetryManager.activeCount"
          ],
          "height": 200
        },
        {
          "title": "CPU Temperature",
          "channels": ["SystemMonitor.cpuTempC"],
          "height": 180,
          "y_min": 0,
          "y_max": 100,
          "y_label": "C",
          "thresholds": [
            {
              "value": 75,
              "color": "#d29922",
              "label": "warn"
            },
            {
              "value": 85,
              "color": "#f85149",
              "label": "crit"
            }
          ]
        },
        {
          "title": "RAM Utilization",
          "channels": ["SystemMonitor.ramUsedPercent"],
          "height": 160,
          "y_min": 0,
          "y_max": 100,
          "y_label": "%",
          "thresholds": [
            {
              "value": 80,
              "color": "#d29922",
              "label": "warn"
            },
            {
              "value": 95,
              "color": "#f85149",
              "label": "crit"
            }
          ]
        },
        {
          "title": "Open File Descriptors",
          "channels": ["SystemMonitor.fdCount"],
          "height": 140,
          "y_label": "count"
        }
      ]
    }
  ]
}
