{
  "layouts": [
    {
      "name": "Wave Output",
      "plots": [
        {
          "title": "Waveform Output",
          "channels": ["WaveGenerator#0.output", "WaveGenerator#1.output"],
          "height": 220,
          "y_label": "amplitude"
        },
        {
          "title": "Phase",
          "channels": ["WaveGenerator#0.phase", "WaveGenerator#1.phase"],
          "height": 160,
          "y_label": "radians"
        }
      ]
    },
    {
      "name": "Wave Detail",
      "plots": [
        {
          "title": "WaveGen #0 Output",
          "channels": ["WaveGenerator#0.output"],
          "height": 220,
          "y_label": "amplitude",
          "y_min": -1.5,
          "y_max": 1.5,
          "thresholds": [
            { "value": 1.0, "color": "#d29922", "label": "upper limit" },
            { "value": -1.0, "color": "#d29922", "label": "lower limit" }
          ]
        },
        {
          "title": "WaveGen #1 Output",
          "channels": ["WaveGenerator#1.output"],
          "height": 220,
          "y_label": "amplitude",
          "y_min": -3.0,
          "y_max": 3.0,
          "thresholds": [
            { "value": 2.0, "color": "#d29922", "label": "upper limit" },
            { "value": -2.0, "color": "#d29922", "label": "lower limit" }
          ]
        },
        {
          "title": "Step Counters",
          "channels": [
            "WaveGenerator#0.stepCount",
            "WaveGenerator#1.stepCount"
          ],
          "height": 140,
          "y_label": "count"
        }
      ]
    },
    {
      "name": "System Health",
      "plots": [
        {
          "title": "CPU Temperature",
          "channels": ["SystemMonitor.cpuTempC"],
          "height": 180,
          "y_min": 0,
          "y_max": 100,
          "y_label": "C",
          "thresholds": [
            { "value": 75, "color": "#d29922", "label": "warn" },
            { "value": 85, "color": "#f85149", "label": "crit" }
          ]
        },
        {
          "title": "RAM Utilization",
          "channels": ["SystemMonitor.ramUsedPercent"],
          "height": 160,
          "y_min": 0,
          "y_max": 100,
          "y_label": "%",
          "thresholds": [
            { "value": 80, "color": "#d29922", "label": "warn" },
            { "value": 95, "color": "#f85149", "label": "crit" }
          ]
        },
        {
          "title": "Open File Descriptors",
          "channels": ["SystemMonitor.fdCount"],
          "height": 140,
          "y_label": "count"
        }
      ]
    }
  ]
}
