{
  "application": "ApexSpecDemo",
  "description": "Spec-born sensor demo proving the spec-driven codegen chain.",
  "protocol": {
    "transport": "TCP",
    "framing": "SLIP",
    "port": 9000,
    "header": "AprotoProtocol.json"
  },
  "components": [
    {
      "name": "Executive",
      "fullUid": "0x000000",
      "type": "EXECUTIVE",
      "dataFile": "ApexExecutive.json",
      "notes": "System executive. Health via GET_HEALTH (opcode 0x0100)."
    },
    {
      "name": "Scheduler",
      "fullUid": "0x000100",
      "type": "CORE",
      "dataFile": "Scheduler.json",
      "notes": "Task scheduler. Health via GET_HEALTH (opcode 0x0100)."
    },
    {
      "name": "FileSystem",
      "fullUid": "0x000200",
      "type": "CORE",
      "notes": "File I/O for TPRM loading, file transfers, and library management."
    },
    {
      "name": "Registry",
      "fullUid": "0x000300",
      "type": "CORE",
      "notes": "Component and data registry. Handles INSPECT queries."
    },
    {
      "name": "Interface",
      "fullUid": "0x000400",
      "type": "CORE",
      "dataFile": "ApexInterface.json",
      "notes": "TCP/SLIP interface. Stats via GET_STATS (opcode 0x0100)."
    },
    {
      "name": "Action",
      "fullUid": "0x000500",
      "type": "CORE",
      "dataFile": "ActionComponent.json",
      "notes": "Sequence engine. Stats via GET_STATS (opcode 0x0100)."
    },
    {
      "name": "SpecSensor",
      "fullUid": "0x00D400",
      "type": "SW_MODEL",
      "instanceIndex": 0,
      "notes": "Spec-born drift sensor (50 Hz step, IDLE/MEASURE/FAULT_INJECT)",
      "dataFile": "SpecSensor.json"
    },
    {
      "name": "SpecActuator",
      "fullUid": "0x00D500",
      "type": "SW_MODEL",
      "instanceIndex": 0,
      "notes": "Proto-authored slewing actuator (50 Hz step, rate-limited)",
      "dataFile": "SpecActuator.json"
    },
    {
      "name": "SpecBusDriver",
      "fullUid": "0x00D600",
      "type": "DRIVER",
      "instanceIndex": 0,
      "notes": "Loopback bus driver (50 Hz drain)",
      "dataFile": "SpecBusDriver.json"
    },
    {
      "name": "SpecMatrix",
      "fullUid": "0x00D700",
      "type": "SUPPORT",
      "notes": "Full type-vocabulary checksum component",
      "dataFile": "SpecMatrix.json"
    },
    {
      "name": "SpecLimits",
      "fullUid": "0x00D800",
      "type": "SW_MODEL",
      "instanceIndex": 0,
      "notes": "Constraint-torture model (every rail kind)",
      "dataFile": "SpecLimits.json"
    },
    {
      "name": "SpecProtoMax",
      "fullUid": "0x00D900",
      "type": "SW_MODEL",
      "instanceIndex": 0,
      "notes": "Maximal proto-profile reference",
      "dataFile": "SpecProtoMax.json"
    },
    {
      "name": "SpecChannel",
      "fullUid": "0x00DA00",
      "type": "SW_MODEL",
      "instanceIndex": 0,
      "notes": "Ramp channel A (multi-instance pair)",
      "dataFile": "SpecChannel.json"
    },
    {
      "name": "SpecChannel",
      "fullUid": "0x00DA01",
      "type": "SW_MODEL",
      "instanceIndex": 1,
      "notes": "Ramp channel B (multi-instance pair)",
      "dataFile": "SpecChannel.json"
    },
    {
      "name": "SystemMonitor",
      "fullUid": "0x00C800",
      "type": "SUPPORT",
      "dataFile": "SystemMonitor.json"
    }
  ],
  "systemOpcodes": {
    "description": "System opcodes (0x0000-0x00FF) handled by ApexInterface.",
    "interface": {
      "0x0000": "SYS_NOOP - connectivity check (any fullUid)",
      "0x0001": "SYS_PING - echo payload back",
      "0x0020": "FILE_BEGIN - start file upload",
      "0x0021": "FILE_CHUNK - file data chunk",
      "0x0022": "FILE_END - finalize upload",
      "0x0023": "FILE_ABORT - abort transfer",
      "0x0024": "FILE_STATUS - query transfer status",
      "0x0025": "FILE_GET - request file download",
      "0x0026": "FILE_READ_CHUNK - read chunk from target"
    },
    "component": {
      "0x0080": "GET_COMMAND_COUNT - command statistics (all components)",
      "0x0081": "GET_STATUS_INFO - component lifecycle status (all components)",
      "0x0100": "GET_HEALTH/GET_STATS - component-specific health telemetry"
    }
  },
  "inspectCategories": {
    "0": "STATIC_PARAM - read-only constants",
    "1": "TUNABLE_PARAM - runtime-adjustable parameters",
    "2": "STATE - internal component state",
    "3": "INPUT - external data fed to component",
    "4": "OUTPUT - data produced by component"
  }
}
